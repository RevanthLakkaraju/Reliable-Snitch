SITE_ORIGIN=http://localhost:3000
# Run pnpm setup:local to generate an ignored .env and private local access-code file.
# For hosting, set these as secret runtime values in Sites, never in client code.
# DEMO_SESSION_SECRET is now the password pepper: retain it while accounts exist.
# DEMO_SESSION_SECRET=<independent-random-32-byte-base64url-key>
# OFFICIAL_ACCESS_CODE_HASH=<sha256-hex-of-owner-issued-random-municipal-code>
# Rotating OFFICIAL_ACCESS_CODE_HASH revokes official sessions and requires the new code.
# The former DEMO_ACCESS_CODE_HASH invitation is no longer used for authentication.
